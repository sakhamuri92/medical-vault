#!/bin/sh
# Enforce commit message format:
#   [TYPE] Short description (max 72 chars)
#   [TYPE: MD-XXXX] Short description (ticket-linked)
#
# Valid TYPEs: STORY, DEFECT, CHORE, FEAT, FIX, DOCS, REFACTOR, TEST

commit_msg=$(cat "$1")

pattern='^\[(STORY: MD-[0-9]+|DEFECT: MD-[0-9]+|CHORE|FEAT|FIX|DOCS|REFACTOR|TEST)\] .{1,72}$'

if ! echo "$commit_msg" | grep -qE "$pattern"; then
  echo ""
  echo "❌ Invalid commit message format."
  echo ""
  echo "Expected format:"
  echo "  [TYPE] Short description              (max 72 chars)"
  echo "  [TYPE: MD-XXXX] Short description     (ticket-linked)"
  echo ""
  echo "Valid TYPEs:"
  echo "  [STORY: MD-1234]   Feature tied to a ticket"
  echo "  [DEFECT: MD-1234]  Bug fix tied to a ticket"
  echo "  [CHORE]            Config, deps, maintenance"
  echo "  [FEAT]             Feature without a ticket"
  echo "  [FIX]              Bug fix without a ticket"
  echo "  [DOCS]             Documentation changes"
  echo "  [REFACTOR]         Code restructuring"
  echo "  [TEST]             Adding or fixing tests"
  echo ""
  echo "Examples:"
  echo "  git commit -m \"[CHORE] Configure Husky and lint-staged\""
  echo "  git commit -m \"[STORY: MD-1234] Add family member CRUD screens\""
  echo ""
  exit 1
fi
